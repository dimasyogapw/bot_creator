# Salin file ini menjadi .env.local lalu isi nilainya. Jangan commit .env.local.
# Di Claude Code web, isi lewat Environment variables di pengaturan environment.

# LLM (OpenAI-compatible). Default SumoPod, cadangan OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://ai.sumopod.com/v1
LLM_API_KEY=            # RAHASIA: key SumoPod sk-...
LLM_DEFAULT_MODEL=claude-sonnet-5-5
LLM_LIGHT_MODEL=claude-haiku-5-5

# Embedding (diputuskan setelah npm run check:provider)
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Supabase (key format baru)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_..., aman untuk browser
SUPABASE_SECRET_KEY=                    # RAHASIA: sb_secret_..., hanya server

OWNER_EMAIL=
